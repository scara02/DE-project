table FactAirQualityDaily
	lineageTag: 1855a077-04a1-4564-a74d-2a81f0ce85ab
	sourceLineageTag: [dbo].[FactAirQualityDaily]

	measure 'Avg Pollutant Value' = AVERAGE(FactAirQualityDaily[avg_pollutant_value])
		lineageTag: 31cbcafd-9c6f-4176-97b3-f82320ffbd87

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Highest Avg Pollutant' =
			
			VAR SummaryTable =
			    SUMMARIZE(
			        FactAirQualityDaily,
			        FactAirQualityDaily[pollutant],
			        "AvgValue", [Avg Pollutant Value]
			    )
			VAR TopPollutant =
			    TOPN(
			        1,
			        SummaryTable,
			        [AvgValue],
			        DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopPollutant,
			        FactAirQualityDaily[pollutant],
			        ", "
			    )
		lineageTag: 6c09e3d1-c76a-4ec4-85dd-383f28a68943

		changedProperty = Name

	measure 'Peak Pollutant Value' =
			
			MAX(FactAirQualityDaily[max_pollutant_value])
		lineageTag: 0efac3d6-c1eb-4d83-b5f1-b31a5510b9ae

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Avg Pollutant Value' =
			
			DIVIDE(
			    SUMX(
			        FactAirQualityDaily,
			        FactAirQualityDaily[avg_pollutant_value] * FactAirQualityDaily[measurement_count]
			    ),
			    SUM(FactAirQualityDaily[measurement_count])
			)
		lineageTag: 163f125f-fddd-4533-b040-1398ff9160c2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weighted Avg PM2.5' =
			
			CALCULATE(
			    [Weighted Avg Pollutant Value],
			    FactAirQualityDaily[pollutant] = "pm25"
			)
		lineageTag: bf2cccea-8864-43d2-b27b-4c089df67b8e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pollutant 7D MA' =
			
			AVERAGEX(
			    DATESINPERIOD(
			        DimDate[full_date],
			        MAX(DimDate[full_date]),
			        -7,
			        DAY
			    ),
			    [Weighted Avg Pollutant Value]
			)
		lineageTag: e4b50991-1479-4333-b22f-445e44d9ab97

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

