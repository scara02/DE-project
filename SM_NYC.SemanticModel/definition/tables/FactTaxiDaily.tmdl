table FactTaxiDaily
	lineageTag: 5ea50f4a-71c7-4180-a274-45844085339e
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure 'Total Trips2' = SUM(FactTaxiDaily[trip_count])
		formatString: 0
		lineageTag: 5acfb964-381e-4575-9f05-1a0c43f0cdf7

		changedProperty = Name

	measure 'Total Trips 7D MA' =
			
			AVERAGEX(
			    DATESINPERIOD(
			        DimDate[full_date],
			        MAX(DimDate[full_date]),
			        -7,
			        DAY
			    ),
			    [Total Trips2]
			)
		lineageTag: 3d541c86-d630-4904-b964-d5b0bca63ce1

		changedProperty = Name

